[
 {
  "id": 1,
  "chapter": 1,
  "trigger": {
   "type": "newGame"
  },
  "lines": [
   {
    "who": "narrator",
    "text": "病毒爆发第十年。幸存者退守堡垒，靠议会的配给苟活。"
   },
   {
    "who": "narrator",
    "text": "堡垒7号，全城最破的堡垒。外婆留给你的，只有它，和半块合成核心。"
   },
   {
    "who": "officer",
    "text": "钢铁议会收编官。三十罐罐头，买你这座垃圾堆。"
   },
   {
    "who": "officer",
    "text": "抱着两个破木箱想过末日？签字吧，小子。"
   },
   {
    "who": "narrator",
    "text": "你没有说话，只是把两把锈刀拖到了一起。"
   },
   {
    "who": "narrator",
    "text": "锈刀相叠，纹路重组——一柄精钢刃，寒光刺眼。"
   },
   {
    "who": "hero",
    "text": "这座堡垒，只收尸潮，不收叛徒。"
   },
   {
    "who": "officer",
    "text": "……好，很好。（他转身拨通电话）"
   },
   {
    "who": "officer",
    "text": "确认。核心，在他手里。"
   },
   {
    "who": "narrator",
    "text": "把两个相同的物品拖到一起，就能合成更高级的物资。第一天，开始了。"
   }
  ]
 },
 {
